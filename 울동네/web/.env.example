# Supabase 연결 정보
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 어드민 로그인 비밀번호 (최소 8자 이상 권장)
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-random-secret-32chars

# Google AdSense & 앱 설치 링크 (선택)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_APP_STORE_URL=https://yjstudio.app

# Firebase Cloud Messaging (FCM HTTP v1 푸시 발송용 - 서비스 계정 JSON 문자열)
FIREBASE_SERVICE_ACCOUNT_JSON=
