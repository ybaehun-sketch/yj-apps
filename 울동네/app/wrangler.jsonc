{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "uldongne-mobile",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.wooldongne.com",
      "custom_domain": true
    }
  ]
}
